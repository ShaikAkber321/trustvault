# Local development defaults are intentionally non-production. Set a unique secret in deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Local: sqlite:///trustvault.db | Render PostgreSQL: use the Internal Database URL
DATABASE_URL=sqlite:///trustvault.db
# Demo accounts are seeded by python init_db.py. Change all passwords for any real deployment.
SEED_ADMIN_PASSWORD=ChangeThisAdmin!2026
SEED_OWNER_PASSWORD=ChangeThisOwner!2026
SEED_VIEWER_PASSWORD=ChangeThisViewer!2026
COOKIE_SECURE=false
MAX_CONTENT_LENGTH=5242880

# memory:// is for local/single-instance use; use shared Redis for multi-instance deployments.
RATELIMIT_STORAGE_URI=memory://
SESSION_LIFETIME_SECONDS=28800
